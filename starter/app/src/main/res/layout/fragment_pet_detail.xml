<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pawhaven_bg"
    android:fillViewport="true">



    <LinearLayout
        android:id="@+id/detailRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Top row: big image + name/age + sound -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/detailPetImage"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@drawable/bg_pet_image_rounded"
                android:contentDescription="@string/pet_image"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_dog" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detailPetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Bella"
                    android:textColor="@color/pawhaven_text"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/detailPetAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="2 years"
                    android:textColor="@color/pawhaven_text"
                    android:textSize="24sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right|bottom"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detailShareButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="0dp"
                android:contentDescription="@string/share"
                app:backgroundTint="@color/pawhaven_orange"
                app:icon="@drawable/ic_share"
                app:iconSize="32dp" />

            <com.udacity.pawhaven.components.PlayPauseComponent
                android:id="@+id/detailSoundButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/play_sound" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="6dp"
            android:text="Bella is a cute dog."
            android:textColor="@color/pawhaven_text"
            android:textSize="20sp" />

        <!-- Big adopt button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/adoptButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="32dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="@string/adopt_a_paw"
            android:textAllCaps="false"
            android:textSize="28sp"
            app:backgroundTint="@color/pawhaven_orange"
            app:cornerRadius="36dp"
            app:elevation="6dp" />

        <!-- breathing room -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

    </LinearLayout>
</ScrollView>
